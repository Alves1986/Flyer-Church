# Etapa de extração (visão) — provedor padrão, GRÁTIS.
# Crie uma chave grátis em openrouter.ai/keys (não é cobrado nada usando os
# modelos ":free" do seletor). Tier grátis: ~20 req/min, 50 req/dia (sobe
# para 1000/dia após adicionar US$10 de crédito à conta, mesmo sem gastar).
OPENROUTER_API_KEY=

# Etapa de extração (visão) — alternativa paga, se preferir Claude em vez
# dos modelos grátis da OpenRouter (selecione "Anthropic Claude" no formulário).
ANTHROPIC_API_KEY=

# Etapa de geração de imagem — necessária para o botão "Gerar flyer"
# Modelo padrão usado: gemini-2.5-flash-image (Google AI Studio). A OpenRouter
# ainda não tem modelo de geração de imagem gratuito, por isso essa etapa
# continua usando a API do Google diretamente.
# IMPORTANTE (2026): a Google não libera cota gratuita para este modelo —
# mesmo com chave válida, a chamada falha com HTTP 429 RESOURCE_EXHAUSTED e
# limit: 0 no tier grátis. É necessário habilitar faturamento (billing) no
# projeto do Google Cloud vinculado a esta chave (console.cloud.google.com).
GOOGLE_API_KEY=

# ============================================================
# CLERK AUTH (Fase 3 — SaaS Multi-Igreja)
# ============================================================
# Obtenha em clerk.com → Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook secret (Clerk Dashboard → Webhooks → Signing Secret)
CLERK_WEBHOOK_SECRET=
# URLs de redirect pós-login/signup (opcional, Clerk usa defaults se omitido)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================================
# PADDLE BILLING (Fase 3 — SaaS Multi-Igreja)
# ============================================================
# Obtenha em vendor.paddle.com → Developer Tools → API Keys
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Environment: sandbox | production
PADDLE_ENV=sandbox
# Product IDs no Paddle (crie os produtos no dashboard primeiro)
PADDLE_PRODUCT_FREE=pri_free
PADDLE_PRODUCT_PRO=pri_pro
PADDLE_PRODUCT_CHURCH=pri_church

# Opcional — persistência em banco (Vercel Postgres, via integração Neon).
# Não precisa preencher manualmente: ao conectar um banco em
# Vercel → Storage → Create Database → Postgres, a Vercel injeta essa
# variável automaticamente (localmente, rode `vercel env pull .env.local`
# para copiá-la). Sem ela, o app funciona normalmente salvando os
# templates no localStorage.
DATABASE_URL=

# Opcional — upload de imagens (Vercel Blob).
# Também injetada automaticamente ao conectar um Blob store em
# Vercel → Storage → Blob. Sem ela, as imagens seguem sendo enviadas como
# base64 embutido nas chamadas de API, como hoje.
BLOB_READ_WRITE_TOKEN=

# Opcional — usado apenas para montar a URL absoluta em metadados de
# Open Graph/Twitter. Defina como a URL de produção do seu deploy na Vercel.
NEXT_PUBLIC_SITE_URL=