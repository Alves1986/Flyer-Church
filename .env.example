# ============================================================
# FLYERFORGE - Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local ou credenciais reais.
#
# Variáveis marcadas com [OBRIGATÓRIO] são necessárias para
# funcionalidades específicas funcionarem. As demais são opcionais.
# ============================================================

# ============================================================
# ETAPA 1: EXTRAÇÃO DE TEMPLATE (VISÃO)
# ============================================================
# Provedor padrão (GRÁTIS): OpenRouter
# Crie uma chave grátis em https://openrouter.ai/keys
# Modelos ":free" não cobram nada. Tier grátis: ~20 req/min, 50 req/dia
# (sobe para 1000/dia após adicionar US$10 de crédito, mesmo sem gastar).
# [OBRIGATÓRIO para extração]
OPENROUTER_API_KEY=

# Provedor alternativo (PAGO): Anthropic Claude
# Use se preferir modelos da Anthropic em vez dos modelos grátis da OpenRouter
# [OPCIONAL]
ANTHROPIC_API_KEY=

# ============================================================
# ETAPA 2: GERAÇÃO DE IMAGEM (GEMINI)
# ============================================================
# Modelo: gemini-2.5-flash-image (Google AI Studio / Vertex AI)
# IMPORTANTE (2026+): A Google NÃO libera cota gratuita para este modelo.
# Mesmo com chave válida, a chamada falha com HTTP 429 RESOURCE_EXHAUSTED
# e limit: 0 no tier grátis.
# É OBRIGATÓRIO habilitar faturamento (billing) no projeto do Google Cloud
# vinculado a esta chave: https://console.cloud.google.com
# Acesse: AI Studio → Get API Key → Create project → Enable billing
# [OBRIGATÓRIO para geração de flyers]
GOOGLE_API_KEY=

# ============================================================
# CLERK AUTH (Multi-tenancy / SaaS)
# ============================================================
# Obtenha em: https://dashboard.clerk.com → API Keys
# [OBRIGATÓRIO para multi-tenancy / login]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Webhook secret: Clerk Dashboard → Webhooks → Signing Secret
# URL do webhook: https://seu-dominio.vercel.app/api/clerk/webhook
# [OBRIGATÓRIO para sincronização de organizações/usuários]
CLERK_WEBHOOK_SECRET=

# URLs de redirect (opcionais - Clerk usa defaults se omitido)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================================
# PADDLE BILLING (Cobrança recorrente / SaaS)
# ============================================================
# Obtenha em: https://vendor.paddle.com → Developer Tools → API Keys
# [OBRIGATÓRIO para cobrança / planos pagos]
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Environment: sandbox | production
PADDLE_ENV=sandbox

# Product IDs no Paddle (crie os produtos no dashboard antes)
# Free: pri_free (ou ID do produto Free)
# Pro: pri_pro
# Church: pri_church
PADDLE_PRODUCT_FREE=pri_free
PADDLE_PRODUCT_PRO=pri_pro
PADDLE_PRODUCT_CHURCH=pri_church

# ============================================================
# BANCO DE DADOS (Postgres via Vercel/Neon)
# ============================================================
# Injetada automaticamente ao conectar banco em:
# Vercel Dashboard → Storage → Create Database → Postgres
# Localmente: `vercel env pull .env.local` para copiar da Vercel
# [OPCIONAL - sem ela, usa localStorage]
DATABASE_URL=
# Alternativa (algumas instalações antigas da Vercel usam esta)
POSTGRES_URL=

# ============================================================
# VERCEL BLOB (Upload de imagens persistentes)
# ============================================================
# Injetada automaticamente ao conectar Blob em:
# Vercel Dashboard → Storage → Blob
# [OPCIONAL - sem ela, imagens vão como base64 nas APIs]
BLOB_READ_WRITE_TOKEN=

# ============================================================
# CONFIGURAÇÕES GERAIS
# ============================================================
# URL pública do deploy (usada em Open Graph, webhooks, emails)
# Ex: https://flyerchurch.vercel.app
NEXT_PUBLIC_SITE_URL=

# Chave pública do Google Fonts API (para FontPicker buscar fontes)
# Crie em: https://console.cloud.google.com/apis/credentials
# [OPCIONAL - sem ela, usa fallback de 18 fontes locais]
NEXT_PUBLIC_GOOGLE_FONTS_KEY=

# ============================================================
# OBSERVABILIDADE (Opcional - para produção)
# ============================================================
# Sentry DSN (error tracking)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Axiom / Logflare (structured logs)
# AXIOM_API_KEY=
# AXIOM_DATASET=

# PostHog (product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# FEATURE FLAGS (Opcional)
# ============================================================
# Unleash / LaunchDarkly / custom
# FEATURE_FLAG_URL=
# FEATURE_FLAG_API_KEY=

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. Nomes das variáveis são CASE-SENSITIVE. Use exatamente como acima.
# 2. No Vercel: Project Settings → Environment Variables → Add New
# 3. Para desenvolvimento local: `cp .env.example .env.local`
# 4. Para sincronizar da Vercel: `vercel env pull .env.local`
# 5. Nunca commite .env.local ou credenciais reais no Git.